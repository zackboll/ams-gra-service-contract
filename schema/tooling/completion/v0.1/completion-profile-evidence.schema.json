{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ams-gra-service-contract:tooling:completion-profile-evidence:0.1",
  "title": "Completion Profile Evidence Links",
  "description": "Tooling-only explicit links from observed completion targets to fixed OMS profile facts; not a Service Contract or mapping.",
  "type": "object", "additionalProperties": false,
  "required": ["profile_evidence_version", "links"],
  "properties": {
    "profile_evidence_version": {"const": "0.1"},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
  },
  "$defs": {
    "link": {"type": "object", "additionalProperties": false, "required": ["target", "profile_fact"], "properties": {
      "target": {"type": "string", "minLength": 1},
      "profile_fact": {"$ref": "#/$defs/profile_fact"}
    }},
    "profile_fact": {"type": "object", "additionalProperties": false, "required": ["kind", "profile_function", "field"], "properties": {
      "kind": {"enum": ["required_function_fact", "required_exchange_fact"]},
      "profile_function": {"type": "string", "minLength": 1},
      "selector": {"type": "string", "minLength": 1},
      "field": {"type": "string", "minLength": 1}
    }, "allOf": [{"if": {"properties": {"kind": {"const": "required_exchange_fact"}}}, "then": {"required": ["selector"]}}]}
  }
}
