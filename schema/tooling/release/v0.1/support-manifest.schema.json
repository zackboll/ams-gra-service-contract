{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository release support manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["support_manifest_version", "project_release", "portable_contract", "oms_profiles", "uci"],
  "properties": {
    "support_manifest_version": {"const": "0.1"},
    "project_release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "portable_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["versions", "schema", "canonical_schema_sha256", "conformance_manifest"],
      "properties": {
        "versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "schema": {"type": "string"},
        "canonical_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "conformance_manifest": {"type": "string"}
      }
    },
    "oms_profiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "oms_version", "profile_format", "path"],
        "properties": {
          "id": {"type": "string"}, "oms_version": {"type": "string"},
          "profile_format": {"type": "string"}, "path": {"type": "string"}
        }
      }
    },
    "uci": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_versions", "baseline_manifests"],
      "properties": {
        "baseline_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "baseline_manifests": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "schema_version", "path"],
            "properties": {
              "id": {"type": "string"},
              "schema_version": {"type": "string"},
              "path": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
