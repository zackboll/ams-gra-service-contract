{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackboll/ams-gra-service-contract/schema/schema-source/v0.1/schema-source-manifest.schema.json",
  "title": "Schema Source Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "schema_family",
    "schema_version",
    "role",
    "source",
    "root_schema",
    "files"
  ],
  "properties": {
    "manifest_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "schema_family": {"const": "uci"},
    "schema_version": {"type": "string", "minLength": 1},
    "role": {"enum": ["baseline", "extension"]},
    "compatible_baseline_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision"],
      "properties": {
        "kind": {"const": "git"},
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "root_schema": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "extension"}}},
      "then": {"required": ["compatible_baseline_versions"]},
      "else": {"not": {"required": ["compatible_baseline_versions"]}}
    }
  ]
}
