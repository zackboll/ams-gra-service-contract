{
  "contract_version": "0.1",
  "service": {
    "name": "Synthetic Completion Service",
    "version": "1.0.0",
    "kind": "service"
  },
  "standards": {
    "oms_version": "2.5",
    "uci_schema_version": "2.5"
  },
  "functions": [
    {
      "id": "service-initialization",
      "name": "Service Initialization",
      "category": "required",
      "required_group": "service",
      "applicability": "applicable",
      "exchanges": [
        {
          "id": "file-metadata",
          "kind": "oms_message",
          "direction": "input",
          "mandate": "optional",
          "message": "FileMetadata",
          "topic": "mission.file-metadata",
          "timing": {
            "kind": "asynchronous"
          }
        },
        {
          "id": "file-location",
          "kind": "oms_message",
          "direction": "input",
          "mandate": "optional",
          "message": "FileLocation",
          "topic": "mission.file-location",
          "timing": {
            "kind": "asynchronous"
          }
        },
        {
          "id": "service-config-file",
          "kind": "data_transfer",
          "direction": "input",
          "mandate": "optional",
          "name": "ServiceConfigFile",
          "protocol": "https",
          "data_type": "ServiceConfigFile",
          "data_format": "application/json",
          "sharing_pattern": "request_response",
          "timing": {
            "kind": "asynchronous"
          }
        }
      ]
    },
    {
      "id": "service-status",
      "name": "Service Status",
      "category": "required",
      "required_group": "service",
      "applicability": "applicable",
      "exchanges": [
        {
          "id": "service-status-report",
          "kind": "oms_message",
          "direction": "output",
          "mandate": "mandatory",
          "message": "ServiceStatus",
          "topic": "mission.service-status",
          "timing": {
            "kind": "periodic",
            "nominal_rate_hz": 1.0
          }
        },
        {
          "id": "service-status-request",
          "kind": "oms_message",
          "direction": "input",
          "mandate": "mandatory",
          "message": "ServiceStatusDataRequest",
          "topic": "mission.service-status-request",
          "timing": {
            "kind": "asynchronous"
          }
        },
        {
          "id": "service-status-request-status",
          "kind": "oms_message",
          "direction": "output",
          "mandate": "mandatory",
          "message": "ServiceStatusDataRequestStatus",
          "topic": "mission.service-status-request-status",
          "timing": {
            "kind": "on_demand",
            "nominal_response_seconds": 0.5
          }
        }
      ]
    },
    {
      "id": "esm-capability-status",
      "name": "ESM Capability and Capability Status",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_status",
      "capability": "esm",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "esm-capability-enable-disable",
      "name": "ESM Capability Enable Disable",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_enable_disable",
      "capability": "esm",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "esm-capability-operations",
      "name": "ESM Capability Operations",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_operations",
      "capability": "esm",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "radar-capability-status",
      "name": "Radar Capability and Capability Status",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_status",
      "capability": "radar",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "radar-capability-enable-disable",
      "name": "Radar Capability Enable Disable",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_enable_disable",
      "capability": "radar",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "radar-capability-operations",
      "name": "Radar Capability Operations",
      "category": "required",
      "required_group": "capability",
      "standard_role": "capability_operations",
      "capability": "radar",
      "applicability": "applicable",
      "exchanges": []
    },
    {
      "id": "position-information-processing",
      "name": "Position Information Processing",
      "category": "required",
      "required_group": "capability",
      "standard_role": "position_information_processing",
      "applicability": "applicable",
      "exchanges": []
    }
  ],
  "capabilities": [
    {
      "id": "esm",
      "name": "ESM",
      "requires_position_information": true
    },
    {
      "id": "radar",
      "name": "Radar",
      "requires_position_information": false
    }
  ]
}
