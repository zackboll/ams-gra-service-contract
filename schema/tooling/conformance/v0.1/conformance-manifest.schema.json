{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ams-gra-service-contract:tooling:conformance-manifest:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["conformance_version", "contract_version", "portable_schema", "schema_canonical_sha256", "cases"],
  "properties": {
    "conformance_version": {"const": "0.1"},
    "contract_version": {"const": "0.1"},
    "portable_schema": {"type": "string", "minLength": 1},
    "schema_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "expect", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "expect": {"enum": ["valid", "invalid"]},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reference_diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SC_[A-Z0-9_]+$"}, "uniqueItems": true},
        "equivalence_group": {"type": "string", "minLength": 1},
        "input_format_safety": {"type": "boolean"}
      }
    }
  }
}
