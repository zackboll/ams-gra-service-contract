{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ams-gra-service-contract:profile-schema:oms:0.1",
  "title": "AMS GRA OMS Profile Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "id", "oms_version", "contract_versions", "sources", "required_functions"],
  "properties": {
    "profile_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/profileIdentifier"},
    "oms_version": {"type": "string", "minLength": 1},
    "contract_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "required_functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requiredFunction"}},
    "required_capability_functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requiredCapabilityFunction"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$", "minLength": 1},
    "profileIdentifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "uri"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string", "minLength": 1},
        "document_number": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"}, "uri": {"type": "string", "format": "uri"}
      }
    },
    "traceRef": {
      "type": "object", "additionalProperties": false, "required": ["source", "locator"],
      "properties": {"source": {"$ref": "#/$defs/identifier"}, "locator": {"type": "string", "minLength": 1}}
    },
    "requiredFunction": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "applies_to", "category", "required_group", "traceability"],
      "oneOf": [
        {"required": ["applicability"], "not": {"required": ["allowed_applicability"]}},
        {"required": ["allowed_applicability"], "not": {"required": ["applicability"]}}
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["service", "subsystem", "isolator"]}},
        "category": {"enum": ["required", "specific"]},
        "required_group": {"enum": ["service", "subsystem", "capability"]},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "allowed_applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["applicable", "not_applicable"]}},
        "traceability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/traceRef"}},
        "required_exchanges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requiredExchange"}}
      }
    },
    "requiredCapabilityFunction": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "applies_to", "category", "required_group", "applicability", "per_capability", "traceability"],
      "properties": {
        "role": {"enum": ["capability_status", "capability_enable_disable", "capability_operations", "position_information_processing"]},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["service", "subsystem", "isolator"]}},
        "category": {"enum": ["required", "specific"]},
        "required_group": {"enum": ["service", "subsystem", "capability"]},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "per_capability": {"type": "boolean"},
        "requires_position_information": {"type": "boolean"},
        "traceability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/traceRef"}}
      }
    },
    "requiredExchange": {
      "oneOf": [
        {"$ref": "#/$defs/requiredOmsMessageExchange"},
        {"$ref": "#/$defs/requiredDataTransferExchange"}
      ]
    },
    "requiredOmsMessageExchange": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "message", "direction", "mandate", "timing_kind", "traceability"],
      "properties": {
        "kind": {"const": "oms_message"},
        "message": {"type": "string", "minLength": 1},
        "direction": {"enum": ["input", "output"]},
        "mandate": {"enum": ["mandatory", "optional"]},
        "timing_kind": {"enum": ["asynchronous", "on_demand", "periodic"]},
        "traceability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/traceRef"}}
      }
    },
    "requiredDataTransferExchange": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "direction", "mandate", "timing_kind", "traceability"],
      "properties": {
        "kind": {"const": "data_transfer"},
        "name": {"type": "string", "minLength": 1},
        "direction": {"enum": ["input", "output"]},
        "mandate": {"enum": ["mandatory", "optional"]},
        "timing_kind": {"enum": ["asynchronous", "on_demand", "periodic"]},
        "traceability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/traceRef"}}
      }
    }
  }
}
