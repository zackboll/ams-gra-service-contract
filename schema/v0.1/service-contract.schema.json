{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ams-gra-service-contract:schema:0.1",
  "title": "AMS GRA Machine-Readable Service Contract",
  "description": "Experimental, non-authoritative machine-readable companion representation for OMS Service Contract function interfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "service",
    "standards",
    "functions"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "standards": {
      "$ref": "#/$defs/standards"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "minLength": 1
    },
    "traceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "uri"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "document_number": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "service",
            "subsystem",
            "isolator"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "requires_position_information"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requires_position_information": {
          "type": "boolean"
        }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oms_version",
        "uci_schema_version"
      ],
      "properties": {
        "oms_version": {
          "type": "string",
          "minLength": 1
        },
        "uci_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "uci_extension_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "ams_gra_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "applicability",
        "exchanges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "required",
            "specific"
          ]
        },
        "required_group": {
          "enum": [
            "service",
            "subsystem",
            "capability"
          ]
        },
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "not_applicable_reason": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        },
        "exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exchange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "specific"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "not": {
              "required": [
                "required_group"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "required": [
              "not_applicable_reason"
            ],
            "properties": {
              "exchanges": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "timing": {
      "oneOf": [
        {
          "$ref": "#/$defs/timingAsynchronous"
        },
        {
          "$ref": "#/$defs/timingOnDemand"
        },
        {
          "$ref": "#/$defs/timingPeriodic"
        }
      ]
    },
    "timingAsynchronous": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "asynchronous"
        }
      }
    },
    "timingOnDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "on_demand"
        },
        "nominal_response_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "timingPeriodic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "periodic"
        },
        "nominal_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "exchange": {
      "oneOf": [
        {
          "$ref": "#/$defs/omsMessageExchange"
        },
        {
          "$ref": "#/$defs/dataTransferExchange"
        },
        {
          "$ref": "#/$defs/specialSignalExchange"
        },
        {
          "$ref": "#/$defs/securityExchange"
        },
        {
          "$ref": "#/$defs/nonOmsMessageExchange"
        }
      ]
    },
    "omsMessageExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "mandate",
        "message",
        "topic",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "oms_message"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "mandate": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "operational_attribute": {
          "type": "string",
          "minLength": 1
        },
        "subscription_group": {
          "type": "string",
          "minLength": 1
        },
        "appendix_c_mapping": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        }
      }
    },
    "dataTransferExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "mandate",
        "name",
        "protocol",
        "data_type",
        "data_format",
        "sharing_pattern",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "data_transfer"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "mandate": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "data_format": {
          "type": "string",
          "minLength": 1
        },
        "sharing_pattern": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        }
      }
    },
    "specialSignalExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "mandate",
        "name",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "special_signal"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "mandate": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        }
      }
    },
    "securityExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "mandate",
        "name",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "security_exchange"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "mandate": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        }
      }
    },
    "nonOmsMessageExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "mandate",
        "name",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "non_oms_message"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "mandate": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "traceability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceRef"
          },
          "default": []
        }
      }
    }
  }
}
